<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	<PublishAot>false</PublishAot>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Content\ava6.png" />
    <None Remove="Content\Graphics\Shaders\Test.comp" />
    <None Remove="Content\Graphics\Shaders\TestFrag.frag" />
    <None Remove="Content\Graphics\Shaders\Testing\TestVert.vert" />
    <None Remove="Content\Graphics\Shaders\voxelCompositing.frag" />
    <None Remove="Content\Graphics\Shaders\voxelCompositing.vert" />
    <None Remove="Content\Graphics\Shaders\voxelRender.frag" />
    <None Remove="Content\Graphics\Shaders\voxelRender.vert" />
    <None Remove="Content\Graphics\Shaders\voxelRenderFlat.frag" />
    <None Remove="Content\Graphics\Textures\router.png" />
    <None Remove="Content\Graphics\UI\ImGuiStyles\style.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content\Graphics\UI\ImGuiStyles\style.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\Graphics\Shaders\tempAntiAliasingBasicShader.comp">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\Graphics\Shaders\tempAntiAliasingReprojectionShader.comp">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\Graphics\Shaders\copyTex8.comp">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\Graphics\Shaders\Testing\TestFrag.frag">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\Graphics\Shaders\Testing\Test.comp" />
    <EmbeddedResource Include="Content\Graphics\Shaders\Testing\TestVert.vert">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\Graphics\Shaders\voxelRenderComputeBrickmap.comp" />
    <EmbeddedResource Include="Content\Graphics\Textures\router.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\Graphics\Shaders\voxelCompositing.frag">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\Graphics\Shaders\voxelCompositing.vert">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.0.1" />
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\DisposeExt\DisposeExt.csproj" />
    <ProjectReference Include="..\..\packages\GLAV\GLAV.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\Graphics\Textures\env.hdr">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Content\Graphics\Textures\map.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Content\Graphics\Textures\map_hdr.hdr">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>
