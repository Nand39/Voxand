        }
    }
    else if (stepMask.z > 0)
    {
        if (gridStep.z == 1)
        {
            side = 4;
        }
        else 
        {
            side = 5;
        }
    }
    normal = side;
    return 0;
}

vec3 scatter(int normal, int sampleIndex)
{
    vec2 randomSampler = fragPosition.xy * sampleIndex * 68.8;
    float key1 = random(randomSampler); 
    float key2 = random((randomSampler * key1 * 22.314));
    float key3 = random(vec2(key1 * -12.3, key2 + 34));
    return rotateVerticalByNormal(randomVector(vec3(key1, key2, key3), sampleIndex), normal);
}

vec3 rotateVerticalByNormal(vec3 vector, int normal)
{
    switch (normal)
    {
        case 0: return vector;
        case 1: return vec3(vector.x, -vector.y, vector.z);
        case 2: return vec3(-vector.y, vector.x, vector.z);
        case 3: return vec3(vector.y, -vector.x, vector.z);
        case 4: return vec3(vector.x, vector.z, -vector.y);
        case 5: return vec3(vector.x, -vector.z, vector.y);
    }
    return vector;
}

void executePathTracing(vec3 origin, vec3 dir, out vec3 albedo, out vec3 luminance, out float depth, out int normal)
{
    vec3 firstHitPos;
    material firstHitMat;

    material secondHitMat;
    int secondHitResult;

    int firstHitResult = trace(origin, dir, firstHitPos, firstHitMat, normal, depth);

    if (firstHitResult == 1)
    {
        albedo = vec3(1);

        float factor = skyFactor(dir);
        luminance = ambientLightingLocal * factor;
        return;
    }
    if (firstHitResult != 0)
    {
        albedo = vec3(1, 0, 0);
        luminance = vec3(1);
        return;
    }

    vec3 indirectContribution = vec3(0);

    int i = 1;
    while(i <= samples)
    {
        vec3 scatteredDir = scatter(normal, i);
        secondHitResult = traceLast(firstHitPos, scatteredDir, secondHitMat);
        if (secondHitResult == 0)
        {
            indirectContribution += secondHitMat.emission;
            i++;
            continue;
        }
        if (secondHitResult == 1)
        {
            float factor = skyFactor(scatteredDir);
            indirectContribution += ambientLightingLocal * factor;
            i++;
            continue;
        }
        i++;
    }

    int exposedToSun = traceLast(firstHitPos, vec3(0.27, 0.8, 0.53), secondHitMat);
    vec3 sunExposure = vec3(0.7, 0.6, 0.4) * exposedToSun * clamp(dot(rotateVerticalByNormal(vec3(0, 1, 0), normal), vec3(0.27, 0.8, 0.53)), 0, 1);;
    albedo = firstHitMat.color;
    luminance = firstHitMat.emission + indirectContribution * invSamples + sunExposure;
    return;
}

vec3 randomVector(vec3 key, int sampleIndex)
{
    float theta = jitterArc * key.x + jitterArc * sampleIndex + TWO_PI * key.z;
    float phi = (-1 * sqrt(1 - key.y * key.y) + 1) * 1.370796 + 0.2;
    float cosPhi = cos(phi);
    return vec3(sin(theta) * cosPhi, sin(phi), cosPhi * cos(theta));
}

float random (vec2 point) 
{
    point *= randSaltLocal;
    return fract(sin(dot(point.xy, vec2(12.9898,78.233))) * 43758.5453123);
}

float minVec3(vec3 vect)
{
    return min(min(vect.x, vect.y), vect.z);
}

float maxVec3(vec3 vect)
{
    return max(max(vect.x, vect.y), vect.z);
}

float cart2Sph_Phi(vec3 vect)
{
    return atan(sqrt(vect.x * vect.x + vect.y * vect.y), vect.z) * 2;
}

float cart2Sph_Theta(vec3 vect)
{
    return atan(vect.y, vect.x) * 2;
}

float skyFactor(vec3 dir)
{
    return tanh(dir.y * 30) * 0.45 + 0.55;
}

int traverse(vec3 origin, vec3 dir, out vec3 hitPos, out material hitMat, out int normal, out float depth)
{
    // Vars

	vec3 timeToCrossSigned = 1.0 / dir;
    vec3 invTimeToCross = abs(dir);
	vec3 timeToCross = abs(timeToCrossSigned);
	ivec3 axisSigns;
	ivec3 voxPos = ivec3(floor(origin));
    depth = 0;
    uint voxelValue;
    uint voxelBit;
    uint DF = (voxelMap[voxPos.y * compoundMapSizeLocal.x * compoundMapSizeLocal.z + voxPos.z * compoundMapSizeLocal.x + (voxPos.x >> 2)] 
               >> ((voxPos.x & 3) * 8) & 255);
    bool escaped = true;
    vec3 timeToEscape;

    // Initialization

    if (dir.x < 0)
    {
        timeToEscape.x = voxPos.x * timeToCross.x;
        axisSigns.x = -1;
    }
    else if (dir.x > 0)
    {
        timeToEscape.x = (mapSizeLocal.x - voxPos.x) * timeToCross.x;
        axisSigns.x = 1;
    }
    else
    {
        timeToEscape.x = intMaxValue;
        axisSigns.x = 0;
    }

    if (dir.y < 0)
    {
        timeToEscape.y = voxPos.y * timeToCross.y;
        axisSigns.y = -1;
    }
    else if (dir.y > 0)
    {
        timeToEscape.y = (mapSizeLocal.y - voxPos.y) * timeToCross.y;
        axisSigns.y = 1;
    }
    else
    {
        timeToEscape.y = intMaxValue;
        axisSigns.y = 0;
    }

    if (dir.z < 0)
    {
        timeToEscape.z = voxPos.z * timeToCross.z;
        axisSigns.z = -1;
    }
    else if (dir.z > 0)
    {
        timeToEscape.z = (mapSizeLocal.z - voxPos.z) * timeToCross.z;
        axisSigns.z = 1;
    }
    else
    {
        timeToEscape.z = intMaxValue;
        axisSigns.z = 0;
    }

    float maxDepth = minVec3(timeToEscape);

	vec3 nextIntersectionTime = (voxPos - origin + 0.5 + vec3(axisSigns) * 0.5) * timeToCrossSigned;
    while (true)
    {
        // Traversal
        
//        if (DF > 1)
//        {
//            if (DF > 2)
//            {
//                vec3 m = floor(invTimeToCross * float(DF - 1));
//                nextIntersectionTime += m * timeToCross;
//                ivec3 mi = ivec3(m);
//                voxPos += mi * axisSigns;
//            }
//            ivec3 mask = ivec3(step(nextIntersectionTime.xyz, nextIntersectionTime.yzx) * step(nextIntersectionTime.xyz, nextIntersectionTime.zxy));
//            nextIntersectionTime += mask * timeToCross;
//            voxPos += ivec3(mask) * axisSigns;
//        }
        
		ivec3 mask = ivec3(step(nextIntersectionTime.xyz, nextIntersectionTime.yzx) * step(nextIntersectionTime.xyz, nextIntersectionTime.zxy));
        voxPos += mask * axisSigns;

        if (minVec3(nextIntersectionTime) > maxDepth) break;

        // Voxel retrieval

        ivec3 maskRegion = ivec3(voxPos.x >> 2, voxPos.y >> 1, voxPos.z >> 2);
        ivec3 maskIndex = ivec3(voxPos.x & 3, voxPos.y & 1, voxPos.z & 3);
		
        voxelValue = voxelMap[voxPos.y * compoundMapSizeLocal.x * compoundMapSizeLocal.z + 
                                voxPos.z * compoundMapSizeLocal.x + 
                                maskRegion.x];
        voxelValue = (voxelValue >> (maskIndex.x * 8)) & 255;

        uint bitmaskBlock = voxelBitmask[maskRegion.y * compoundVoxelBitmaskSizeLocal.x * compoundVoxelBitmaskSizeLocal.z + 
                                    maskRegion.z * compoundVoxelBitmaskSizeLocal.x +
                                    maskRegion.x];
        voxelBit = bitmaskBlock & (1 << ((maskIndex.y << 4) + (maskIndex.z << 2) + maskIndex.x));

        if (voxelBit == 0)
        {
            DF = voxelValue;
        }
        else 
        {
            escaped = false;
            break;
        }

        // Only update nextIntersectionTime after conditional break to preserve voxel entering depth
		nextIntersectionTime += mask * timeToCross;
    }    
    if (escaped) 
    {
        return 1;
    }

    // Get depth and normal
    if (nextIntersectionTime.x < nextIntersectionTime.y)
    {
        if (nextIntersectionTime.x < nextIntersectionTime.z)
        {
            depth = nextIntersectionTime.x;
            normal = 0;
        }
        else 
        {
            depth = nextIntersectionTime.z;
            normal = 1;
        }
    }
    else 
    {
        if (nextIntersectionTime.y < nextIntersectionTime.z)
        {
            depth = nextIntersectionTime.y;
            normal = 2;
        }
        else 
        {
            depth = nextIntersectionTime.z;
            normal = 1;
        }
    }

    if (normal == 2)
    {
        if (axisSigns.y == -1)
        {
            normal = 0;
        }
        else 
        {
            normal = 1;
        }
    }
    else if (normal == 0)
    {
        if (axisSigns.x == 1)
        {
            normal = 2;
        }
        else 
        {
            normal = 3;
        }
    }
    else if (normal == 1)
    {
        if (axisSigns.z == 1)
        {
            normal = 4;
        }
        else 
        {
            normal = 5;
        }
    }

    hitPos = origin + dir * depth;
    hitMat = materialPalette[voxelValue];
    return 0;
}

