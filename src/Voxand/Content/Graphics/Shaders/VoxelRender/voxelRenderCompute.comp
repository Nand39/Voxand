#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;



// Image buffers

layout(rgba32f, binding = 0) uniform image2D albedoTexture;

layout(rgba32f, binding = 1) uniform image2D luminanceTexture;

layout(r32f, binding = 2) uniform image2D depthTexture;

layout(r32i, binding = 3) uniform iimage2D normalTexture;

// SSBOs

struct material
{
    vec3 color;
    // 4 bytes padding
    vec3 emission;
    // 4 bytes padding
};

layout(std430, binding = 0) buffer brickListSSBO
{
    uint voxelMap[];
};

layout(std430, binding = 1) buffer bitmaskSSBO
{
    uint voxelBitmask[];
};

layout(std430, binding = 2) buffer palette
{
    material materialPalette[];
};

layout(std430, binding = 3) buffer inputData
{
    mat4 inverseCameraMatrix;
    vec3 cameraPosition;
    float randSalt;
    vec3 ambientLighting;
    ivec3 mapSize;
    ivec3 compoundMapSize;
    ivec3 compoundVoxelBitmaskSize;
};

struct teststruct
{
    int a;
    float b;
};

layout(std430, binding = 4) buffer testlist
{
    teststruct list[];
};

// Global vars

const float TWO_PI = 6.283185;

int samples = 2;
float invSamples = 1.0 / samples;
float jitterArc = TWO_PI / samples;
vec2 fragPosition;

float randSaltLocal;
vec3 ambientLightingLocal;
ivec3 mapSizeLocal;
ivec3 compoundMapSizeLocal;
ivec3 compoundVoxelBitmaskSizeLocal;

const int intMaxValue = 2147483647;
const float depthBias = -0.02;


// Function prototypes
void executePathTracing(vec3 origin, vec3 dir, out vec3 albedo, out vec3 luminance, out float depth, out int normal);

int trace        (vec3 origin, vec3 dir, out vec3 hitPos, out material hitMat, out int normal, out float depth);
int traceLast    (vec3 origin, vec3 dir, out material hitMat);
int traverse     (vec3 origin, vec3 dir, out vec3 hitPos, out material hitMat, out int normal, out float depth);  // Experimantal
int traverseLast (vec3 origin, vec3 dir, out material hitMat);

