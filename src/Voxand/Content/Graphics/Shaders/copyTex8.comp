#version 430 core
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform sampler2D source;
layout(rgba32f, binding = 0) uniform image2D destination;

void main() 
{
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID);
    vec2 uv = vec2(texelCoord) / imageSize(destination); 
    imageStore(destination, texelCoord, texture2D(source, uv));
}